# Variáveis do docker-compose (copie para .env na raiz do G3- antes de subir)
# cp .env.docker.example .env

# Banco
POSTGRES_USER=clinica
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=clinica

# Backend
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:8090,http://localhost:5173
PUBLIC_URL=http://localhost:8000

# Portas expostas no host (mude se estiverem ocupadas)
FRONTEND_PORT=8090
POSTGRES_HOST_PORT=5433

# Frontend (URL da API embutida no build)
VITE_API_URL=http://localhost:8000
