# Memed — isolamento de ambientes (Manual de Validação Técnica).
# MEMED_ENV controla a URL da API e do script automaticamente:
#   homologacao -> https://integrations.api.memed.com.br/v1  (padrão; chaves demo embutidas)
#   producao    -> https://api.memed.com.br/v1               (exige chaves reais abaixo)
# NÃO use sandbox.memed.com.br (instável, critério de reprovação na homologação).
MEMED_ENV=homologacao
# Defina só se o onboarding fornecer endpoints específicos:
# MEMED_BASE_URL=
# MEMED_SCRIPT_URL=
# Prefixo do idExterno (evita colisão no ambiente de homologação compartilhado):
MEMED_ID_PREFIXO=g3clinica
MEMED_API_KEY=your_memed_api_key_here
MEMED_SECRET_KEY=your_memed_secret_key_here

# Integração Autolac (laboratório de apoio). A URL base é fornecida pelo
# laboratório de apoio — não há valor público padrão.
AUTOLAC_BASE_URL=https://api.autolac.exemplo.com.br
AUTOLAC_APOIADO_ID=123
AUTOLAC_SENHA=sua_senha_em_texto_puro
